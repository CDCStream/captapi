# =====================================================
# Application
# =====================================================
APP_ENV=development
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
APP_BASE_URL=http://localhost:8000

# =====================================================
# Supabase
# =====================================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
SUPABASE_ANON_KEY=eyJhbGc...

# =====================================================
# Data providers (optional — set in deployment secrets)
# =====================================================
# Do not commit real provider tokens or vendor resource IDs.
# Production configures these in the host environment / secret store.
APIFY_TOKEN=
APIFY_SYNC_TIMEOUT_SECONDS=120
APIFY_SYNC_MAX_ATTEMPTS=1
APIFY_SYNC_RETRY_MAX_WAIT_SECONDS=3
MCP_TOOL_TIMEOUT_SECONDS=120

# Optional third-party scraping API (Instagram GraphQL path, etc.)
DECODO_AUTH_TOKEN=
DECODO_USERNAME=
DECODO_PASSWORD=
DECODO_BASE=https://scraper-api.decodo.com/v2
DECODO_LOCALE=en-us
DECODO_GEO=

# Optional TikTok web-signer sidecar
TIKTOK_SIGNER_URL=

# Optional: GitHub public API rate limits for /v1/github
GITHUB_TOKEN=

# Optional: Reddit OAuth app (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: Instagram session cookie(s) for richer native paths
IG_SESSION_ID=
IG_SESSION_IDS=

# Optional: HTTP proxies for direct platform fetches
# Format: http://user:pass@host:port
PROXY_DATACENTER_URL=
PROXY_RESIDENTIAL_URL=

# =====================================================
# OpenAI
# =====================================================
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_SUMMARY=gpt-4o-mini
OPENAI_MODEL_TRANSCRIPTION=whisper-1
# Optional — when set, /v1/youtube/audio-transcript prefers Groq Whisper.
# GROQ_API_KEY=
# GROQ_MODEL_TRANSCRIPTION=whisper-large-v3-turbo

# =====================================================
# Payments — active Merchant of Record
# =====================================================
# Which provider is live. "paddle" is active; "dodo" is a dormant fallback.
PAYMENT_PROVIDER=paddle   # paddle | dodo

# --- Paddle Billing (active) ---
# API key: Paddle dashboard > Developer tools > Authentication > API keys.
PADDLE_API_KEY=
# Webhook signing secret: Paddle dashboard > Developer tools > Notifications.
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox   # sandbox | production

# Subscription price IDs (create products + recurring prices in Paddle; pri_...)
PADDLE_PRICE_STARTER_MONTHLY=pri_...
PADDLE_PRICE_STARTER_YEARLY=pri_...
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_YEARLY=pri_...
PADDLE_PRICE_BUSINESS_MONTHLY=pri_...
PADDLE_PRICE_BUSINESS_YEARLY=pri_...

# One-time PAYG credit pack price IDs (2k / 10k / 50k credits; pri_...)
PADDLE_PRICE_PACK_STARTER=pri_...
PADDLE_PRICE_PACK_GROWTH=pri_...
PADDLE_PRICE_PACK_SCALE=pri_...

# --- Dodo Payments (dormant fallback) ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode   # test_mode | live_mode

# Subscription product IDs (create these in the Dodo dashboard)
DODO_PRODUCT_STARTER_MONTHLY=prod_...
DODO_PRODUCT_STARTER_YEARLY=prod_...
DODO_PRODUCT_PRO_MONTHLY=prod_...
DODO_PRODUCT_PRO_YEARLY=prod_...
DODO_PRODUCT_BUSINESS_MONTHLY=prod_...
DODO_PRODUCT_BUSINESS_YEARLY=prod_...

# One-time PAYG credit pack product IDs (2k / 10k / 50k credits)
DODO_PRODUCT_PACK_STARTER=prod_...
DODO_PRODUCT_PACK_GROWTH=prod_...
DODO_PRODUCT_PACK_SCALE=prod_...

# =====================================================
# Redis (Upstash)
# =====================================================
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# =====================================================
# Limits
# =====================================================
CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=60
# Per-plan request-per-minute limits (must match the pricing page)
RATE_LIMIT_FREE=40
RATE_LIMIT_STARTER=120
RATE_LIMIT_PRO=300
RATE_LIMIT_BUSINESS=600
# Free-plan daily billable TikTok transcript calls (cache hits do not count)
FREE_TIKTOK_TRANSCRIPT_DAILY=5
# Public free-tool daily tries per client (requires TOOL_PROXY_SECRET match from Next.js)
ANON_TIKTOK_TRANSCRIPT_DAILY=3
# Must match frontend CAPTAPI_TOOL_PROXY_SECRET when set
TOOL_PROXY_SECRET=
MAX_VIDEO_UPLOAD_MB=200
MAX_VIDEO_DURATION_MINUTES=60

# =====================================================
# Observability
# =====================================================
SENTRY_DSN=
LOG_LEVEL=INFO
# Funnel response JSON capture (fire-and-forget; no client latency).
# Enable in prod when you want journey debugging; keep sample rate at 1.0 for 100%.
LOG_RESPONSE_BODIES=false
LOG_RESPONSE_SAMPLE_RATE=1.0
LOG_RESPONSE_MAX_BYTES=262144
# Comma-separated ids never sampled (loyal user + tools@captapi.com service account).
RESPONSE_SAMPLE_EXCLUDE_USER_IDS=3f48e876-2044-465a-a517-81a9b34fb830,111dc024-18cf-4a81-8041-827e1c684a41
RESPONSE_SAMPLE_EXCLUDE_API_KEY_IDS=9efa68f6-6f98-4ef4-b2ed-bbd118db03be

# =====================================================
# Transactional email (Resend)
# =====================================================
RESEND_API_KEY=
EMAIL_FROM=Captapi <no-reply@captapi.com>
FRONTEND_URL=http://localhost:3000
